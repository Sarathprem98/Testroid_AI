{
  "name": "testroid",
  "version": "1.2.0",
  "description": "AI-powered multi-agent Playwright test framework generator",
  "main": "dist/cli.js",
  "bin": {
    "testroid": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format cjs --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarathprem98/Testroid_AI.git"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "ai-agents",
    "test-automation",
    "cli",
    "scaffolding"
  ],
  "author": "Sarath Prem",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/Sarathprem98/Testroid_AI/issues"
  },
  "homepage": "https://github.com/Sarathprem98/Testroid_AI#readme",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "deepmerge": "^4.3.1",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "semver": "^7.8.5",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
